{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "words-into-music",
  "version": "1.0.0",
  "description": "Create original songs from an idea or your own lyrics, track generation and browse your private library through the Words into Music MCP server.",
  "author": {
    "name": "Words into Music",
    "email": "contact@wordsintomusic.com",
    "url": "https://wordsintomusic.com/"
  },
  "homepage": "https://wordsintomusic.com/mcp/",
  "repository": "https://github.com/constantinginga/words-into-music-mcp",
  "license": "MIT",
  "keywords": [
    "music",
    "songwriting",
    "song-generator",
    "lyrics",
    "mcp"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "words-into-music": {
          "trust": "untrusted",
          "cost_unit": "song credits",
          "costs": {
            "start_song": {
              "credits": 1,
              "note": "Uses one Words into Music song credit. Starting the same preparation again returns the same job at no extra cost."
            }
          }
        }
      }
    }
  }
}
